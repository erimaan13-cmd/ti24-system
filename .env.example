# ─── Base de datos (Postgres / Supabase) ───────────────────────────────
# Local:    postgres://postgres:postgres@localhost:5432/ti24_dev
# Supabase: usar la cadena del "Transaction pooler" (puerto 6543). Nunca subirla al repo.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ti24_dev

# Inquilino (tenant) de TI24. Coincide con supabase/seed.sql.
TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Web pública (apps/web) ────────────────────────────────────────────
# Cloudflare Turnstile (antispam). Sin estas llaves, la verificación se omite (solo desarrollo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Número de WhatsApp en formato internacional sin "+" (ej. 5281XXXXXXXX). Vacío = botón oculto.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL pública del sitio (para sitemap, canonical y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" solo en producción con el aviso de privacidad completo; si no, el sitio pide noindex.
SITE_INDEXABLE=false

# ─── CRM (apps/crm) ────────────────────────────────────────────────────
# Secreto para firmar la cookie de sesión (mín. 32 caracteres). Generar: openssl rand -hex 32
SESSION_SECRET=
# Contraseña de la cuenta demo (modo demo, hasta conectar Supabase Auth).
CRM_DEMO_PASSWORD=
